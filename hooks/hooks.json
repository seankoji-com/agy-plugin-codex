{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/session-lifecycle-hook.mjs\"",
            "statusMessage": "Initializing Antigravity bridge"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/session-lifecycle-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Closing Antigravity bridge"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/stop-review-gate-hook.mjs\"",
            "timeout": 900
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/unread-result-hook.mjs\"",
            "statusMessage": "Checking for unread Antigravity results"
          }
        ]
      }
    ]
  }
}
